# Copy to .env.local and adjust. Only VITE_* values reach the browser, so never put
# Spoonacular or Gemini keys here: those live in backend/.env.

# Local backend (uvicorn app.main:app --reload)
VITE_API_BASE_URL=http://localhost:8000

# Deployed backend
# VITE_API_BASE_URL=https://frigi-app.duckdns.org

# Amazon Cognito (sign-up codes, log-in, forgot password, delete account). Both are public IDs,
# not secrets. Leave empty to use the backend's own log-in, e.g. for local development.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
