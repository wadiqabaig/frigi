# Copy to .env.local and adjust. Only VITE_* values reach the browser, so never put
# Spoonacular or Gemini keys here: those live in backend/.env.

# Local backend (uvicorn app.main:app --reload)
VITE_API_BASE_URL=http://localhost:8000

# Deployed backend
# VITE_API_BASE_URL=https://frigi-app.duckdns.org
