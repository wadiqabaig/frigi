# Copy this file to backend/.env and fill in real values. Never commit .env.

# Long random string used to sign log-in tokens.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Local file database. For AWS RDS PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://frigi_admin:PASSWORD@ENDPOINT:5432/frigi?sslmode=require
DATABASE_URL=sqlite:///./frigi.db

# "mock" returns fixed sample detections so the app can be built without the model.
# "rfdetr" loads the trained RF-DETR Small checkpoint below.
DETECTOR=mock
DETECTOR_WEIGHTS=weights/checkpoint_best_total.pth
DETECTOR_THRESHOLD=0.3

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used automatically when the main model is busy (503) or fails.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
SPOONACULAR_API_KEY=

# "hybrid" (Spoonacular + Gemini) or "llm" (Gemini only, for comparison tests)
CHEF_SOURCE=hybrid

# Amazon Cognito user pool. When both are set, log-in uses Cognito and /auth/signup and
# /auth/login are switched off. Use the same values as the website's VITE_COGNITO_* settings.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
