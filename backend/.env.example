# Copy this file to backend/.env and fill in real values. Never commit .env.

# Long random string used to sign log-in tokens.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

DATABASE_URL=sqlite:///./frigi.db

# "mock" returns fixed sample detections so the app can be built without the model.
# "rfdetr" loads the trained RF-DETR Small checkpoint below.
DETECTOR=mock
DETECTOR_WEIGHTS=weights/checkpoint_best_total.pth
DETECTOR_THRESHOLD=0.3

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SPOONACULAR_API_KEY=
